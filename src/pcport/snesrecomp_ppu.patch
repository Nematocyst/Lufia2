+/* Art override (Lufia II "hi-colour backgrounds", 2026-11-14): while `rgb` is
+ * set, every main/sub screen pixel that comes from `layer` (or the backdrop,
+ * if `backdrop` is set) takes its colour from a full-colour picture placed on
+ * that layer's plane instead of from CGRAM: plane x = screen x + hScroll,
+ * plane y = line + vScroll (mod 256/512), picture pixel = plane - (ox, oy).
+ * Colour math, windows and brightness still apply (in 8 bits per channel).
+ * Pixels outside the picture or with alpha 0 keep the game's own colour. */
+typedef struct PpuArtOverride {
+  const uint32_t *rgb;    /* 0xAARRGGBB, w*h */
+  int w, h, ox, oy;
+  uint8_t layer;          /* 0 = BG1 ... 3 = BG4 */
+  uint8_t backdrop;
+  uint8_t tint;           /* game's palette brightness for the layer: 0 = none,
+                           * bit 7 set = darken (c*(tint-0xC0)/64), else brighten
+                           * toward white ((255-c)*(0x40-tint)/64 from white) */
+} PpuArtOverride;
+extern PpuArtOverride g_ppu_art_override;
