diff --git a/src/lufia2_autopilot.inc b/src/lufia2_autopilot.inc
new file mode 100644
index 0000000..b0eed6b
--- /dev/null
+++ b/src/lufia2_autopilot.inc
@@ -0,0 +1,144 @@
+/* Test autopilot (Lufia II ROM-hack project, 2026-11-14). Included by main.c.
+ *
+ * LUFIA2_AUTOPILOT=script.txt runs the game from a script instead of a player,
+ * as fast as possible, and quits at the end. One command per line:
+ *   boot N              mash START/A N times (title -> new game -> field)
+ *   hold BUTTONS N      hold buttons (A,B,X,Y,L,R,START,SELECT,UP,DOWN,LEFT,RIGHT joined by +) N frames
+ *   wait N              N frames, no buttons
+ *   poke ADDR HEX       write WRAM bytes (ADDR hex, 0-1FFFF) once
+ *   keep ADDR HEX N     write them every frame for N frames (while the next commands run)
+ *   seek ADDR VAL MAX   walk up/down (40 frames each) until WRAM[ADDR] == VAL, at most MAX frames
+ *   until ADDR VAL MAX  no buttons, until WRAM[ADDR] == VAL, at most MAX frames
+ *   shot PATH           save what the player sees as a PPM picture
+ *   dump PATH           save all 128 KB of WRAM
+ *   log TEXT            print a line (with the frame number) to stderr
+ *   quit
+ * Lines starting with # are ignored. Test only: never enabled unless the variable is set. */
+#include <ctype.h>
+
+typedef struct AutoCmd { char op[8]; uint32_t a, b, c; char text[256]; } AutoCmd;
+static AutoCmd *s_ap;
+static int s_ap_n, s_ap_i = -1, s_ap_left;
+static uint32_t s_ap_frame;
+static uint32_t s_keep_addr, s_keep_left;
+static uint8_t s_keep_bytes[64];
+static int s_keep_len;
+
+static uint32_t ApButtons(const char *s) {
+    static const struct { const char *n; uint32_t m; } k[] = {
+        {"A", PAD_A}, {"B", PAD_B}, {"X", PAD_X}, {"Y", PAD_Y}, {"L", PAD_L}, {"R", PAD_R},
+        {"START", PAD_START}, {"SELECT", PAD_SELECT}, {"UP", PAD_UP}, {"DOWN", PAD_DOWN},
+        {"LEFT", PAD_LEFT}, {"RIGHT", PAD_RIGHT}};
+    uint32_t m = 0;
+    char buf[128]; snprintf(buf, sizeof buf, "%s", s);
+    for (char *t = strtok(buf, "+"); t; t = strtok(NULL, "+"))
+        for (size_t i = 0; i < sizeof k / sizeof k[0]; i++)
+            if (strcmp(t, k[i].n) == 0) m |= k[i].m;
+    return m;
+}
+
+static int ApHexBytes(const char *s, uint8_t *out, int max) {
+    int n = 0;
+    while (s[0] && s[1] && n < max && isxdigit((unsigned char)s[0])) {
+        unsigned v; sscanf(s, "%2x", &v); out[n++] = (uint8_t)v; s += 2;
+    }
+    return n;
+}
+
+static bool AutopilotLoad(void) {
+    const char *path = getenv("LUFIA2_AUTOPILOT");
+    if (!path || !*path) return false;
+    FILE *f = fopen(path, "r");
+    if (!f) { fprintf(stderr, "[autopilot] cannot open %s\n", path); return false; }
+    char line[512];
+    while (fgets(line, sizeof line, f)) {
+        if (line[0] == '#' || line[0] == '\n') continue;
+        s_ap = realloc(s_ap, sizeof(AutoCmd) * (size_t)(s_ap_n + 1));
+        AutoCmd *c = &s_ap[s_ap_n++];
+        memset(c, 0, sizeof *c);
+        char x[256] = "", y[256] = "", z[64] = "";
+        sscanf(line, "%7s %255s %255s %63s", c->op, x, y, z);
+        line[strcspn(line, "\r\n")] = 0;
+        if (!strcmp(c->op, "hold")) { c->a = ApButtons(x); c->b = (uint32_t)atoi(y); }
+        else if (!strcmp(c->op, "poke") || !strcmp(c->op, "keep")) {
+            c->a = (uint32_t)strtoul(x, NULL, 16); snprintf(c->text, sizeof c->text, "%s", y);
+            c->c = (uint32_t)atoi(z);
+        } else if (!strcmp(c->op, "seek") || !strcmp(c->op, "until")) {
+            c->a = (uint32_t)strtoul(x, NULL, 16); c->b = (uint32_t)strtoul(y, NULL, 16);
+            c->c = (uint32_t)atoi(z);
+        } else if (!strcmp(c->op, "shot") || !strcmp(c->op, "log") || !strcmp(c->op, "dump")) {
+            const char *p = line + strlen(c->op); while (*p == ' ') p++;
+            snprintf(c->text, sizeof c->text, "%s", p);
+        } else { c->a = (uint32_t)atoi(x); }
+    }
+    fclose(f);
+    fprintf(stderr, "[autopilot] %d commands from %s\n", s_ap_n, path);
+    s_ap_i = 0; s_ap_left = -1;
+    return true;
+}
+
+static void ApShot(const char *path) {
+    FILE *f = fopen(path, "wb");
+    if (!f) return;
+    const int w = s_frame_width, h = SNES_HEIGHT;
+    fprintf(f, "P6\n%d %d\n255\n", w, h);
+    for (int y = 0; y < h; y++)
+        for (int x = 0; x < w; x++) {
+            const uint8_t *p = &s_present_pixels[((size_t)y * w + x) * 4];
+            uint8_t rgb[3] = {p[2], p[1], p[0]};
+            fwrite(rgb, 1, 3, f);
+        }
+    fclose(f);
+    fprintf(stderr, "[autopilot] frame %u: shot %s\n", s_ap_frame, path);
+}
+
+/* Before the guest frame: returns the buttons to press; *quit set at the end. */
+static uint32_t AutopilotInput(bool *quit) {
+    s_ap_frame++;
+    if (s_keep_left) {
+        for (int i = 0; i < s_keep_len && s_keep_addr + (uint32_t)i < 0x20000; i++)
+            g_ram[s_keep_addr + (uint32_t)i] = s_keep_bytes[i];
+        s_keep_left--;
+    }
+    while (s_ap_i < s_ap_n) {
+        AutoCmd *c = &s_ap[s_ap_i];
+        if (!strcmp(c->op, "boot")) {
+            if (s_ap_left < 0) s_ap_left = (int)c->a * 12;
+            if (s_ap_left-- > 0) {
+                const int k = ((int)c->a * 12 - s_ap_left - 1) / 12, ph = ((int)c->a * 12 - s_ap_left - 1) % 12;
+                return ph < 2 ? (k % 7 == 0 ? PAD_START : PAD_A) : 0;
+            }
+        } else if (!strcmp(c->op, "hold") || !strcmp(c->op, "wait")) {
+            const int n = !strcmp(c->op, "hold") ? (int)c->b : (int)c->a;
+            if (s_ap_left < 0) s_ap_left = n;
+            if (s_ap_left-- > 0) return !strcmp(c->op, "hold") ? c->a : 0;
+        } else if (!strcmp(c->op, "poke") || !strcmp(c->op, "keep")) {
+            uint8_t b[64]; int n = ApHexBytes(c->text, b, 64);
+            for (int i = 0; i < n && c->a + (uint32_t)i < 0x20000; i++) g_ram[c->a + (uint32_t)i] = b[i];
+            if (!strcmp(c->op, "keep")) {
+                s_keep_addr = c->a; s_keep_len = n; memcpy(s_keep_bytes, b, (size_t)n); s_keep_left = c->c;
+            }
+        } else if (!strcmp(c->op, "seek") || !strcmp(c->op, "until")) {
+            if (s_ap_left < 0) s_ap_left = (int)c->c;
+            if (g_ram[c->a & 0x1ffff] != (uint8_t)c->b && s_ap_left-- > 0) {
+                if (!strcmp(c->op, "until")) return 0;
+                return ((c->c - (uint32_t)s_ap_left) / 40) % 2 ? PAD_DOWN : PAD_UP;
+            }
+            fprintf(stderr, "[autopilot] frame %u: %s $%05X == %02X: %s\n", s_ap_frame, c->op,
+                    c->a, c->b, g_ram[c->a & 0x1ffff] == (uint8_t)c->b ? "yes" : "TIMEOUT");
+        } else if (!strcmp(c->op, "shot")) {
+            ApShot(c->text);
+        } else if (!strcmp(c->op, "dump")) {
+            FILE *df = fopen(c->text, "wb");
+            if (df) { fwrite(g_ram, 1, 0x20000, df); fclose(df); }
+        } else if (!strcmp(c->op, "log")) {
+            fprintf(stderr, "[autopilot] frame %u: %s | map %02X%02X bg %02X\n", s_ap_frame, c->text,
+                    g_ram[0x5ad], g_ram[0x5ac], g_ram[0x11e1]);
+        } else if (!strcmp(c->op, "quit")) {
+            *quit = true; return 0;
+        }
+        s_ap_i++; s_ap_left = -1;
+    }
+    *quit = true;
+    return 0;
+}
diff --git a/src/lufia2_hicolour_bg.c b/src/lufia2_hicolour_bg.c
new file mode 100644
index 0000000..189e5da
--- /dev/null
+++ b/src/lufia2_hicolour_bg.c
@@ -0,0 +1,91 @@
+/* Hi-colour battle backgrounds (Lufia II ROM-hack project, 2026-11-14).
+ *
+ * While a battle shows background id N and assets/hicolour/battle_NN.l2hc
+ * exists, the PPU's art override (snes/ppu.h, PpuArtOverride) draws that
+ * full-colour picture wherever the game draws its background layer (BG1) or
+ * the backdrop. Nothing in the game changes: it still loads its own 16-colour
+ * tiles; they are simply not what the player sees. Sprites, windows, text,
+ * colour math (spell tints, translucent windows), fades and shakes keep
+ * working because the substitution happens per pixel inside the compositor.
+ *
+ * File format (.l2hc, little endian): "L2HC", u16 width, u16 height,
+ * i16 plane x, i16 plane y (where the picture's top-left sits on BG1's
+ * plane), then width*height u32 0xAARRGGBB. Alpha 0 = keep the game's pixel.
+ */
+#include "lufia2_hicolour_bg.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "host_paths.h"
+#include "snes/ppu.h"
+#include "lufia2_battle.h"
+
+enum { MAX_IDS = 0x40 };
+
+typedef struct Art {
+    uint32_t *rgb;
+    int w, h, ox, oy;
+    bool tried;
+} Art;
+
+static Art s_art[MAX_IDS];
+static int s_disabled = -1;
+
+static bool Load(uint8_t id, Art *a) {
+    char leaf[64], path[1024];
+    snprintf(leaf, sizeof leaf, "assets/hicolour/battle_%02X.l2hc", id);
+    if (!snesrecomp_exe_dir_path(leaf, path, sizeof path))
+        snprintf(path, sizeof path, "%s", leaf);
+    FILE *f = fopen(path, "rb");
+    if (!f)
+        return false;
+    uint8_t hdr[12];
+    bool ok = fread(hdr, 1, 12, f) == 12 && memcmp(hdr, "L2HC", 4) == 0;
+    if (ok) {
+        a->w = hdr[4] | hdr[5] << 8;
+        a->h = hdr[6] | hdr[7] << 8;
+        a->ox = (int16_t)(hdr[8] | hdr[9] << 8);
+        a->oy = (int16_t)(hdr[10] | hdr[11] << 8);
+        size_t n = (size_t)a->w * (size_t)a->h;
+        a->rgb = n ? malloc(n * 4) : NULL;
+        ok = a->rgb && fread(a->rgb, 4, n, f) == n;
+        if (!ok) {
+            free(a->rgb);
+            a->rgb = NULL;
+        }
+    }
+    fclose(f);
+    fprintf(stderr, "[hicolour] battle background $%02X: %s\n", id,
+            ok ? "loaded" : "bad file");
+    return ok;
+}
+
+void Lufia2HiColourBgFrame(const uint8_t *wram) {
+    if (s_disabled < 0) {
+        const char *e = getenv("LUFIA2_HICOLOUR");
+        s_disabled = e && e[0] == '0';
+    }
+    g_ppu_art_override.rgb = NULL;
+    if (s_disabled)
+        return;
+    const Lufia2BattleState b = Lufia2BattleInspect(wram);
+    if (!b.active || b.background_id >= MAX_IDS)
+        return;
+    Art *a = &s_art[b.background_id];
+    if (!a->tried) {
+        a->tried = true;
+        Load(b.background_id, a);
+    }
+    if (!a->rgb)
+        return;
+    g_ppu_art_override.rgb = a->rgb;
+    g_ppu_art_override.w = a->w;
+    g_ppu_art_override.h = a->h;
+    g_ppu_art_override.ox = a->ox;
+    g_ppu_art_override.oy = a->oy;
+    g_ppu_art_override.layer = 0;      /* BG1 = the battle background */
+    g_ppu_art_override.backdrop = 1;   /* see-through parts of BG1 too */
+    g_ppu_art_override.tint = wram[0x1BF3];   /* effect brightness of palette row 2 */
+}
